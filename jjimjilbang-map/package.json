{
  "name": "seoul-jjimjilbang-map",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "서울 찜질방 요금·시설·후기를 비교하는 앱인토스(토스 미니앱) WebView 앱",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build && ait build",
    "build:preview": "vite build --mode preview",
    "preview": "vite preview",
    "deploy": "ait deploy",
    "validate": "node scripts/validate-data.mjs",
    "naver:content": "node scripts/fetch-naver-content.mjs",
    "naver:enrich": "node scripts/enrich-naver-local.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@apps-in-toss/web-framework": "^3.10.0",
    "@emotion/react": "^11.14.0",
    "@toss/tds-mobile": "^2.5.1",
    "@toss/tds-mobile-ait": "^2.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.5.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "@apps-in-toss/devtools": "^3.10.0"
  }
}
